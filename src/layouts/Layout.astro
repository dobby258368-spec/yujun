---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { SITE, NAV } from "../data/site";
import { SERVICES } from "../data/services";
import { business, website, breadcrumb } from "../lib/schema";
import { img } from "../lib/images";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  breadcrumbs?: { name: string; href: string }[];
  schema?: object[];
}

const { title, description, image = "f5266cb3b649429c9de3da2e7a2ef376.png", type = "website", breadcrumbs, schema = [] } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const og = await getImage({ src: img(image), width: 1200, format: "jpg" });
const ogUrl = new URL(og.src, site).href;

const ld = [
  business(site, ogUrl),
  website(site),
  ...(breadcrumbs ? [breadcrumb(site, [{ name: "首頁", href: "/" }, ...breadcrumbs])] : []),
  ...schema,
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
  <a class="skip" href="#main">跳到主要內容</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="logo" href="/" aria-label={`${SITE.name} 首頁`}>宥涒<span>室內裝潢</span></a>
      <nav class="nav" id="nav" aria-label="主選單">
        {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
        <a href="/contact/" class="btn btn-sm">預約諮詢</a>
      </nav>
      <button class="menu-toggle" aria-label="開啟選單" aria-expanded="false" aria-controls="nav"><span></span></button>
    </div>
  </header>

  {breadcrumbs && (
    <nav class="crumbs wrap" aria-label="麵包屑">
      <a href="/">首頁</a>
      {breadcrumbs.map((b, i) => (
        <>
          <span aria-hidden="true">/</span>
          {i === breadcrumbs.length - 1 ? <span aria-current="page">{b.name}</span> : <a href={b.href}>{b.name}</a>}
        </>
      ))}
    </nav>
  )}

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="footer-logo">{SITE.name}</p>
        <p>{SITE.tagline}</p>
        <address>
          <a href={SITE.mapUrl} target="_blank" rel="noopener">{SITE.address.full}</a><br />
          電話：<a href={`tel:${SITE.phoneIntl}`}>{SITE.phone}</a>
        </address>
        <p class="social">
          <a href={SITE.line} target="_blank" rel="noopener">LINE</a>
          <a href={SITE.facebook} target="_blank" rel="noopener">Facebook</a>
        </p>
      </div>
      <div>
        <p class="footer-h">服務項目</p>
        <ul>{SERVICES.map((s) => <li><a href={`/services/${s.slug}/`}>{s.keyword}</a></li>)}</ul>
      </div>
      <div>
        <p class="footer-h">網站導覽</p>
        <ul>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/contact/">聯絡我們</a></li>
        </ul>
      </div>
    </div>
    <p class="copy">© {new Date().getFullYear()} {SITE.name}・服務地區：桃園、中壢及周邊地區</p>
  </footer>

  <div class="float-btns">
    <a href={SITE.line} target="_blank" rel="noopener" class="float-line">LINE 諮詢</a>
    <a href={`tel:${SITE.phoneIntl}`} class="float-tel">撥打電話</a>
  </div>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
    const nav = document.getElementById("nav")!;
    toggle.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
    });
  </script>
</body>
</html>
