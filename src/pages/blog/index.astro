---
import Layout from "../../layouts/Layout.astro";
import ContactCta from "../../components/ContactCta.astro";
import { Image } from "astro:assets";
import { img } from "../../lib/images";
import posts from "../../data/posts.json";

const list = [...posts].sort((a, b) => b.updated.localeCompare(a.updated));
---
<Layout
  title="裝修知識｜桃園室內裝潢、老屋翻修、系統櫃文章｜宥涒室內裝潢"
  description="宥涒室內裝潢整理的裝修知識：裝潢工程規劃與預算、老屋與中古屋翻修重點、新成屋裝潢、統包、室內設計諮詢與系統櫃安裝。"
  breadcrumbs={[{ name: "裝修知識", href: "/blog/" }]}
>
  <section class="section">
    <div class="wrap">
      <h1 class="sec-title">裝修知識<span>Articles</span></h1>
      <div class="cards">
        {list.map((p) => (
          <a class="card" href={`/blog/${p.slug}/`}>
            <Image src={img(p.cover)} alt={p.title} widths={[400, 700]} sizes="(max-width: 640px) 100vw, 33vw" />
            <time datetime={p.updated}>{p.updated}</time>
            <h2 style="font-size:1.05rem;margin:14px 0 6px">{p.title}</h2>
            <p>{p.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <ContactCta />
</Layout>
