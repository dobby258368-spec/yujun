---
import Layout from "../../layouts/Layout.astro";
import HeroSlider from "../../components/HeroSlider.astro";
import Mosaic from "../../components/Mosaic.astro";
import FaqList from "../../components/FaqList.astro";
import ContactCta from "../../components/ContactCta.astro";
import TileGrid from "../../components/TileGrid.astro";
import { getImage } from "astro:assets";
import { SERVICES, type Service } from "../../data/services";
import { CASES } from "../../data/cases";
import { faqPage, service as serviceLd } from "../../lib/schema";
import { img } from "../../lib/images";
import posts from "../../data/posts.json";

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Service };
const heroImg = await getImage({ src: img(s.hero), width: 1200, format: "jpg" });
const post = posts.find((p) => p.service === s.slug);
const cases = CASES.filter((c) => c.services.includes(s.slug));
const others = SERVICES.filter((o) => o.slug !== s.slug);
const slides = [{ image: s.hero, alt: s.keyword }, ...s.blocks.slice(0, 3).map((b) => ({ image: b.image, alt: b.heading }))]
  .filter((x, i, arr) => arr.findIndex((y) => y.image === x.image) === i);
---
<Layout
  title={s.seoTitle}
  description={s.seoDescription}
  image={s.hero}
  breadcrumbs={[{ name: "服務項目", href: "/services/" }, { name: s.keyword, href: `/services/${s.slug}/` }]}
  schema={[serviceLd(Astro.site!, s, new URL(heroImg.src, Astro.site).href), faqPage(s.faqs)]}
>
  <HeroSlider slides={slides} title={s.keyword} subtitle={s.lead} cta={{ href: "/contact/", label: "預約諮詢" }} />

  <section class="section tight">
    <div class="wrap intro">
      <p class="lead">{s.intro}</p>
    </div>
  </section>

  <Mosaic blocks={s.blocks} />

  {s.note && (
    <div class="note">
      <h2>{s.note.heading}</h2>
      <p>{s.note.body}</p>
    </div>
  )}

  <FaqList faqs={s.faqs} heading={`${s.keyword}常見問題`} />

  {(post || cases.length > 0) && (
    <section class="section alt">
      <div class="wrap">
        <h2 class="sec-title">延伸閱讀<span>Read More</span></h2>
      </div>
      <TileGrid
        cols={3}
        intro={post && { heading: post.title, body: post.excerpt, href: `/blog/${post.slug}/`, link: "閱讀文章" }}
        items={cases.map((c) => ({ image: c.cover, title: c.title, sub: "工程實績", href: `/cases/${c.slug}/` }))}
      />
    </section>
  )}

  <section class="section tight">
    <div class="wrap">
      <h2 class="sec-title">其他服務<span>Services</span></h2>
      <ul class="checks" style="columns:3;max-width:900px;margin:0 auto">
        {others.map((o) => <li><a class="more" href={`/services/${o.slug}/`}>{o.keyword}</a></li>)}
      </ul>
    </div>
  </section>

  <ContactCta />
</Layout>
