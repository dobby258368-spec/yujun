---
import Layout from "../../layouts/Layout.astro";
import HeroSlider from "../../components/HeroSlider.astro";
import Mosaic from "../../components/Mosaic.astro";
import ContactCta from "../../components/ContactCta.astro";
import { CASES, type Case } from "../../data/cases";
import { getService } from "../../data/services";

export function getStaticPaths() {
  return CASES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Case };
const services = c.services.map(getService).filter((s) => s !== undefined);
const others = CASES.filter((o) => o.slug !== c.slug);
---
<Layout
  title={`${c.title}｜${c.type}實績｜宥涒室內裝潢`}
  description={c.summary}
  image={c.cover}
  breadcrumbs={[{ name: "工程實績", href: "/cases/" }, { name: c.title, href: `/cases/${c.slug}/` }]}
>
  <HeroSlider slides={c.blocks.map((b) => ({ image: b.image, alt: `${c.title}・${b.heading}` }))} title={c.title} subtitle={c.type} />

  <section class="section tight">
    <div class="wrap intro">
      <p class="lead">{c.summary}</p>
    </div>
  </section>

  <Mosaic blocks={c.blocks} />

  <div class="note">
    <h2>相關服務</h2>
    <p>
      {services.map((s, i) => (
        <>{i > 0 && "・"}<a class="more" href={`/services/${s.slug}/`}>{s.keyword}</a></>
      ))}
    </p>
  </div>

  <section class="section tight">
    <div class="wrap narrow">
      <h2 class="sec-title">其他實績<span>More Projects</span></h2>
      <ul class="checks">
        {others.map((o) => <li><a class="more" href={`/cases/${o.slug}/`}>{o.title}</a>：{o.summary}</li>)}
      </ul>
    </div>
  </section>

  <ContactCta />
</Layout>
