---
import Layout from "../../layouts/Layout.astro";
import HeroSlider from "../../components/HeroSlider.astro";
import TileGrid from "../../components/TileGrid.astro";
import ContactCta from "../../components/ContactCta.astro";
import { CASES } from "../../data/cases";
---
<Layout
  title="工程實績｜桃園老屋翻修、室內裝潢案例｜宥涒室內裝潢"
  description="宥涒室內裝潢工程實績：32 年老屋大改造、躍層住宅客廳翻新、溫潤木質調住宅，以及老屋翻修的拆除、防水與管線施工紀錄。"
  breadcrumbs={[{ name: "工程實績", href: "/cases/" }]}
>
  <HeroSlider
    slides={CASES.map((c) => ({ image: c.cover, alt: c.title }))}
    title="工程實績"
    subtitle="記錄每一個家的改變"
  />
  <TileGrid
    cols={3}
    intro={{
      heading: "從老屋到新居",
      body: "好的裝修不只要有漂亮的成果，更要重視看不見的基礎工程。這裡記錄完工的樣貌，也記錄施工中的每一道工序。",
    }}
    items={CASES.map((c) => ({ image: c.cover, title: c.title, sub: c.type, href: `/cases/${c.slug}/` }))}
  />
  <section class="section tight">
    <div class="wrap narrow">
      {CASES.map((c) => (
        <p><a class="more" href={`/cases/${c.slug}/`}><strong>{c.title}</strong></a>：{c.summary}</p>
      ))}
    </div>
  </section>
  <ContactCta />
</Layout>
