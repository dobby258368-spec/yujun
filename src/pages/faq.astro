---
import Layout from "../layouts/Layout.astro";
import FaqList from "../components/FaqList.astro";
import ContactCta from "../components/ContactCta.astro";
import { GENERAL_FAQS } from "../data/faq";
import { SERVICES } from "../data/services";
import { faqPage } from "../lib/schema";

const all = [...GENERAL_FAQS, ...SERVICES.flatMap((s) => s.faqs)];
---
<Layout
  title="常見問題｜桃園室內裝潢、統包、老屋翻修 Q&A｜宥涒室內裝潢"
  description="宥涒室內裝潢常見問題：服務地區、統包內容、費用怎麼估、裝修流程、進度回報、老屋與中古屋翻修注意事項、系統櫃與木作怎麼選。"
  breadcrumbs={[{ name: "常見問題", href: "/faq/" }]}
  schema={[faqPage(all)]}
>
  <section class="section tight">
    <div class="wrap narrow">
      <h1 class="sec-title">常見問題<span>FAQ</span></h1>
    </div>
  </section>
  <FaqList faqs={GENERAL_FAQS} heading="一般問題" />
  {SERVICES.map((s) => (
    <section class="section tight faq">
      <div class="wrap narrow">
        <h2 style="font-size:1.2rem"><a href={`/services/${s.slug}/`}>{s.keyword}</a></h2>
        {s.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  ))}
  <ContactCta />
</Layout>
