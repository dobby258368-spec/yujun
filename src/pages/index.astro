---
import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import Mosaic from "../components/Mosaic.astro";
import TileGrid from "../components/TileGrid.astro";
import FaqList from "../components/FaqList.astro";
import ContactCta from "../components/ContactCta.astro";
import { Image } from "astro:assets";
import { SITE, WORK_ITEMS } from "../data/site";
import { SERVICES } from "../data/services";
import { CASES } from "../data/cases";
import { GENERAL_FAQS } from "../data/faq";
import { faqPage } from "../lib/schema";
import { img } from "../lib/images";
import posts from "../data/posts.json";

const slides = [
  { image: "f5266cb3b649429c9de3da2e7a2ef376.png", alt: "宥涒室內裝潢 木質調客廳" },
  { image: "34fb38e8c23f4df582fbf321cbf613d6.png", alt: "系統櫃與電視牆整合的客廳" },
  { image: "c43c63ee483141cea9623b06ec1a0d53.png", alt: "明亮的客廳與收納櫃" },
  { image: "279256c7d6964e2ebc25cd623fbf39e2.png", alt: "米白牆面搭配木質地板的住宅" },
  { image: "eca80ba1799547f1a1c7f516afa2e1bc.png", alt: "採光充足的新成屋客廳" },
];

// 首頁圖文（來源：品牌首頁區塊）
const highlights = [
  {
    heading: "桃園室內裝潢統包",
    body: "從拆除到完工，每一道工序都用心把關。我們是深耕大桃園地區的統包工程團隊，整合各類專業工班，協助您統籌施工流程、掌握工程品質，讓裝修大小事都能更有效率地安排。",
    image: "64032842f36b48f4a6a6624f08c053cb.png",
  },
  {
    heading: "室內設計",
    body: "以溫潤的木質色調搭配淺色系櫃體，營造明亮、舒適又耐看的居家氛圍。系統櫃體提升收納機能，電視牆與收納櫃整合，黑框玻璃隔間讓空間保有通透感與層次。",
    image: "34fb38e8c23f4df582fbf321cbf613d6.png",
  },
  {
    heading: "住宅裝修",
    body: "簡約米白牆面搭配溫潤木質地板，再以灰藍色窗簾點綴，營造明亮、舒適又有質感的居家空間。",
    image: "279256c7d6964e2ebc25cd623fbf39e2.png",
  },
  {
    heading: "空間規劃",
    body: "舒服的空間，藏著對生活的講究。從色彩搭配、家具配置，到每一處細節的呈現，讓美感自然融入日常，讓回家成為每天最期待的事。",
    image: "feaf9d93b6614a52a5f80527f038761b.png",
  },
];

const latest = [...posts].sort((a, b) => b.updated.localeCompare(a.updated)).slice(0, 3);
---
<Layout
  title="桃園室內裝潢推薦｜統包・老屋翻修・系統櫃｜宥涒室內裝潢"
  description={SITE.description}
  schema={[faqPage(GENERAL_FAQS)]}
>
  <HeroSlider
    slides={slides}
    title="桃園室內裝潢｜宥涒室內裝潢"
    subtitle="用心築造，讓家更有質感"
    cta={{ href: "/contact/", label: "預約諮詢" }}
  />

  <section class="section tight">
    <div class="wrap intro">
      <h2 class="sec-title">家，不只是居住的空間<span>About</span></h2>
      <p class="lead">
        宥涒室內裝潢是深耕大桃園地區的室內裝修統包團隊。從空間規劃、材質挑選到施工細節，我們用心傾聽每一份需求，以專業與細膩的工藝將理想化為真實，讓美感與實用完美融合，打造舒適、耐看又貼近生活的理想居所。
      </p>
    </div>
  </section>

  <TileGrid
    intro={{
      heading: "服務項目",
      body: "新成屋、中古屋、老屋翻修到系統櫃安裝，一個窗口整合設計與施工。",
      href: "/services/",
      link: "全部服務",
    }}
    items={SERVICES.slice(0, 7).map((s) => ({ image: s.hero, title: s.short, sub: s.en, href: `/services/${s.slug}/` }))}
  />

  <section class="section">
    <div class="wrap">
      <h2 class="sec-title">我們做的事<span>What We Do</span></h2>
    </div>
    <Mosaic blocks={highlights} headingLevel="h3" />
  </section>

  <div class="note">
    <h2>統包可承接的工程項目</h2>
    <p>{WORK_ITEMS.join("・")}</p>
  </div>

  <section class="section alt">
    <div class="wrap">
      <h2 class="sec-title">工程實績<span>Projects</span></h2>
    </div>
    <TileGrid
      intro={{ heading: "從老屋到新居", body: "記錄每一個家的改變，也記錄看不見的基礎工程。", href: "/cases/", link: "看全部實績" }}
      items={CASES.map((c) => ({ image: c.cover, title: c.title, sub: c.type, href: `/cases/${c.slug}/` }))}
    />
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="sec-title">裝修流程<span>Process</span></h2>
      <ol class="steps">
        <li><b>01</b>現場丈量</li>
        <li><b>02</b>需求討論</li>
        <li><b>03</b>設計規劃與報價</li>
        <li><b>04</b>確認後開工</li>
        <li><b>05</b>施工進度回報</li>
        <li><b>06</b>完工驗收</li>
      </ol>
      <p class="center"><a class="more" href="/process/">了解完整流程與工序 →</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2 class="sec-title">裝修知識<span>Articles</span></h2>
      <div class="cards">
        {latest.map((p) => (
          <a class="card" href={`/blog/${p.slug}/`}>
            <Image src={img(p.cover)} alt={p.title} widths={[400, 700]} sizes="(max-width: 640px) 100vw, 33vw" />
            <time datetime={p.updated}>{p.updated}</time>
            <h3>{p.title}</h3>
            <p>{p.excerpt}</p>
          </a>
        ))}
      </div>
      <p class="center" style="margin-top:32px"><a class="more" href="/blog/">更多文章 →</a></p>
    </div>
  </section>

  <FaqList faqs={GENERAL_FAQS.slice(0, 5)} />

  <ContactCta />
</Layout>
