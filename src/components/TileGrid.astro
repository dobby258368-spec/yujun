---
// 無邊圖片磚：可點擊的圖片零間距排列，可在開頭穿插一塊白底說明文字
import { Image } from "astro:assets";
import { img } from "../lib/images";

interface Props {
  items: { image: string; title: string; sub?: string; href: string }[];
  intro?: { heading: string; body: string; href?: string; link?: string };
  cols?: 3 | 4;
}
const { items, intro, cols = 4 } = Astro.props;
---
<div class:list={["tiles", `cols-${cols}`]}>
  {intro && (
    <div class="tile-text">
      <h2>{intro.heading}</h2>
      <p>{intro.body}</p>
      {intro.href && <a href={intro.href} class="more">{intro.link ?? "了解更多"} →</a>}
    </div>
  )}
  {items.map((t) => (
    <a class="tile" href={t.href}>
      <Image src={img(t.image)} alt={t.title} widths={[400, 700, 1000]} sizes={`(max-width: 640px) 50vw, ${Math.round(100 / cols)}vw`} />
      <span class="tile-label">
        <strong>{t.title}</strong>
        {t.sub && <small>{t.sub}</small>}
      </span>
    </a>
  ))}
</div>
