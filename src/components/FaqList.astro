---
import type { Faq } from "../data/services";

interface Props {
  faqs: Faq[];
  heading?: string;
}
const { faqs, heading = "常見問題" } = Astro.props;
---
<section class="section faq">
  <div class="wrap narrow">
    <h2 class="sec-title">{heading}<span>FAQ</span></h2>
    {faqs.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>
