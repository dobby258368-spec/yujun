---
// 無邊圖片拼接：圖片與白底文字塊零間距交錯。
// 桌機一列兩組（4 格），奇數列左右對調形成棋盤格；平板一列一組、逐組對調；手機圖上文下
import { Image } from "astro:assets";
import { img } from "../lib/images";
import type { Block } from "../data/services";

interface Props {
  blocks: Block[];
  numbered?: boolean;
  headingLevel?: "h2" | "h3";
}
const { blocks, numbered = true, headingLevel = "h2" } = Astro.props;
const H = headingLevel;
const lastAlone = blocks.length % 2 === 1;
---
<div class="mosaic">
  {blocks.map((b, i) => (
    <div
      class:list={[
        "m-pair",
        {
          "rev-desk": Math.floor(i / 2) % 2 === 1,
          "rev-tab": i % 2 === 1,
          full: lastAlone && i === blocks.length - 1,
        },
      ]}
    >
      <figure class="m-img">
        <Image
          src={img(b.image)}
          alt={b.heading}
          widths={[480, 800, 1200]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
        />
      </figure>
      <div class="m-text">
        {numbered && <span class="m-no">{String(i + 1).padStart(2, "0")}</span>}
        <H>{b.heading}</H>
        <p>{b.body}</p>
        {b.href && <a class="more" href={b.href} style="margin-top:14px">了解{b.heading} →</a>}
      </div>
    </div>
  ))}
</div>
